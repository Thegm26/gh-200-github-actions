{
  "name": "gh-200-github-actions-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A dependency-light GitHub Actions hands-on lab service.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "playwright-core": "1.58.2",
    "yaml": "2.6.0"
  },
  "scripts": {
    "start": "node _internal/src/server.js",
    "test": "node --test _internal/test/layout.test.mjs _internal/test/curriculum/examples.test.mjs _internal/test/curriculum/quiz.test.mjs _internal/test/curriculum/references.test.mjs _internal/test/runtime/server.test.js _internal/test/runtime/workflows.test.js",
    "quiz": "node _internal/scripts/quiz.mjs",
    "validate:content": "node _internal/scripts/validate-content.mjs",
    "validate:workflows": "node _internal/scripts/verify-workflows.mjs",
    "validate:references": "node _internal/scripts/validate-references.mjs",
    "learn": "node _internal/scripts/learn.mjs",
    "doctor": "node _internal/scripts/doctor.mjs",
    "verify:learning": "node _internal/scripts/verify-learning.mjs",
    "verify:hands-on": "node _internal/scripts/verify-hands-on.mjs",
    "test:learning": "node --test _internal/test/learning/learning.test.mjs _internal/test/learning/course-runtime.test.mjs _internal/test/learning/hands-on.test.mjs",
    "test:browser": "node _internal/test/browser/ui-regression.mjs",
    "build:course": "node _internal/scripts/build-course.mjs",
    "verify:course": "node _internal/scripts/verify-course.mjs",
    "dev": "node _internal/scripts/serve-course.mjs",
    "check": "npm test && npm run test:learning && npm run verify:learning && npm run verify:course && npm run validate:content && npm run validate:references && npm run validate:workflows"
  }
}
